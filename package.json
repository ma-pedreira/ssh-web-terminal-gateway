{
  "name": "ssh-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based SSH terminal with resumable sessions and hosts kept in ~/.ssh/config",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#types": "./src/types/index.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node server.ts --dev",
    "build": "next build",
    "start": "node server.ts",
    "migrate": "node src/lib/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
