node_modules/
.next/
out/
dist/
coverage/
*.log

# Local data, SSH configuration and keys: never in the repository.
# Anchored with / to the root: without the leading slash, "ssh/" would also
# ignore src/lib/ssh and new files there would vanish from commits.
#
# The folders themselves are kept (via .gitkeep) so that a fresh clone already
# has them owned by whoever cloned. Otherwise Docker creates them as root and
# the container, which runs as uid 1000, cannot write to them.
/data/*
!/data/.gitkeep
/ssh/*
!/ssh/.gitkeep
/ssh-keys/*
!/ssh-keys/.gitkeep
.env
.env.local

# Generated by Next and TypeScript
next-env.d.ts
*.tsbuildinfo
