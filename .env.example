# Port the server listens on
PORT=3030

# --- Docker deployment only ---

# Host interface the service is published on.
# 127.0.0.1 = only from the server itself (use an SSH tunnel to reach it).
# Your LAN address = reachable from other machines, over HTTP without TLS.
SSH_WEB_BIND=127.0.0.1

# Host folder holding the standard OpenSSH files.
# Point it at your user's .ssh folder to use your real configuration.
SSH_WEB_SSH_DIR_HOST=./ssh

# Host folder holding the private keys, mounted read-only.
SSH_WEB_KEYS_DIR_HOST=./ssh-keys

# --- Paths inside the process ---
# Outside Docker these can be omitted: the usual folders for each system are
# used (%APPDATA% and %LOCALAPPDATA% on Windows, ~/.config and ~/.local/share
# on Linux and macOS). Almost all of this can be changed later from the
# application's own settings screen.

# SSH_WEB_DB_PATH=/data/ssh-web.db
# SSH_WEB_CONFIG_DIR=/data
# SSH_WEB_SSH_DIR=/ssh
# SSH_WEB_KEYS_DIR=/ssh-keys
# SSH_WEB_VAULT_PATH=/data/credenciales.vault

# Folders the user may choose as a save location from the settings screen.
# Separated by ":" on Unix and by ";" on Windows.
# This is the boundary that stops the interface writing anywhere on disk.
# SSH_WEB_ALLOWED_ROOTS=/data:/ssh:/ssh-keys

# Secure flag on cookies. Set it to true when serving over HTTPS.
SSH_WEB_SECURE_COOKIES=false

# Starting values; changeable from the settings screen.
SSH_WEB_SESSION_IDLE_MINUTES=120
SSH_WEB_REPLAY_BUFFER_KB=256
